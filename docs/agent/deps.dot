digraph qor_deps {
  // Edge A -> B means "A target_links_libraries against B" (A depends on B, B must build first)
  // Source: docs/agent/repo_map.md (from target_link_libraries scan of every src/**/CMakeLists.txt)
  // Generated by agent. Regenerate from repo_map if map changes.
  // http_old NOT in graph (D5: not built, ignore).

  rankdir=LR;
  node [shape=box, fontsize=10];

  // ===== Subsystem clusters =====
  subgraph cluster_qor {
    label="src/qor - universal core";
    rank=same; qor_module; qor_current; qor_reporting; qor_text; qor_textshaping; qor_unicode;
    rank=same; qor_interception; qor_issue; qor_error; qor_log;
    rank=same; qor_property; qor_tef; qor_injection; qor_threadmemory;
  }

  subgraph cluster_framework {
    label="src/framework - structural app parts";
    qor_application; qor_dynamiclibrary; qor_host; qor_optionparser; qor_role; qor_workflow;
    qor_pipeline; qor_resources; qor_image;
    qor_events; qor_signals;
    qor_asyncioservice; qor_filesystem; qor_sockets;
    qor_sync; qor_task; qor_thread; qor_workitem;
    qor_uicommon; qor_desktopui; qor_gl; qor_uilayout; qor_uiselector; qor_sercon; qor_terminal; qor_uiwidgets;
  }

  subgraph cluster_platform {
    label="src/platform - base (arch/os/compiler)";
    qor_platform; qor_arch; qor_compiler;
  }

  subgraph cluster_components {
    label="src/components - leaf libs (not depended on by others)";
    // data/formats
    qor_jsondata; qor_ttf;
    // data/parser
    qor_parser;
    // data/pipeline filters
    qor_base64decodefilter; qor_base64encodefilter; qor_jpegdecodefilter; qor_linereader; qor_unicodetextfilter;
    // data/pipeline sinks
    qor_datasink; qor_deserializersink; qor_parsersink; qor_stringsink;
    // data/pipeline sources
    qor_aggregatesource; qor_datasource; qor_generatorsource; qor_randomsource; qor_stringsource;
    // io
    qor_serialize; qor_generator; qor_netclient; qor_httpclient; qor_socketclient; qor_netserver;
    qor_fileconnector; qor_pipeconnector; qor_socketconnector; qor_stdfstreamconnector;
    qor_stdofstreamsink; qor_stdoutsink; qor_stdifstreamsource; qor_stdinsource;
    // protocols
    qor_echo; qor_http; qor_jip; qor_uri;
    // qor (aggregator)
    qor_logaggregator; qor_loghandler;
    // ui (component variants)
    qor_canvas; qor_console; qor_egl; qor_layout; qor_opengles; qor_renderer; qor_tui; qor_widgets;
  }

  // ===== Edges (A -> B = A depends on B) =====
  qor_current      -> { qor_module; qor_host; qor_injection; }
  qor_reporting    -> { qor_module; qor_host; }
  qor_text         -> { qor_module; qor_host; qor_reporting; }
  qor_textshaping  -> { qor_module; qor_host; qor_reporting; qor_current; }
  qor_unicode      -> { qor_module; qor_host; qor_reporting; qor_current; }
  qor_interception -> { qor_module; qor_host; qor_current; }
  qor_issue        -> { qor_module; qor_host; qor_current; }
  qor_error        -> { qor_module; qor_host; qor_issue; qor_text; qor_current; qor_interception; qor_reporting; }
  qor_log          -> { qor_module; qor_host; qor_current; qor_interception; qor_issue; qor_error; qor_signals; }
  qor_tef          -> { qor_module; qor_host; qor_injection; }
  qor_injection    -> { qor_module; qor_host; }
  qor_threadmemory -> { qor_module; qor_host; qor_current; qor_thread; qor_sync; }
  qor_property     -> { qor_module; qor_host; qor_reporting; qor_current; }

  qor_application   -> { qor_module; qor_thread; qor_sync; qor_platform; qor_role; }
  qor_dynamiclibrary -> { qor_module; qor_host; qor_thread; }
  qor_host          -> { qor_module; qor_sharedbootstrap; }
  qor_optionparser  -> { qor_module; qor_thread; }
  qor_role          -> { qor_module; qor_host; qor_current; qor_sync; qor_platform; qor_error; }
  qor_workflow      -> { qor_module; qor_host; qor_current; qor_issue; qor_error; qor_log; qor_thread; qor_tef; qor_threadmemory; }
  qor_pipeline      -> { qor_module; qor_thread; qor_signals; qor_sync; qor_interception; qor_error; qor_log; }
  qor_resources     -> { qor_module; qor_thread; qor_sync; qor_platform; qor_error; qor_filesystem; }
  qor_image         -> { qor_module; qor_thread; qor_sync; qor_platform; qor_error; qor_filesystem; }
  qor_events        -> { qor_module; qor_thread; qor_sync; qor_interception; }
  qor_signals       -> { qor_module; qor_host; qor_thread; }
  qor_asyncioservice -> { qor_module; qor_host; qor_injection; qor_current; qor_thread; qor_interception; qor_sync; qor_issue; qor_error; qor_log; }
  qor_filesystem    -> { qor_module; qor_host; qor_sync; qor_thread; qor_platform; qor_error; }
  qor_sync          -> { qor_module; qor_host; }
  qor_task          -> { qor_module; qor_host; }
  qor_thread        -> { qor_module; qor_host; qor_current; qor_sync; qor_injection; }
  qor_workitem      -> { qor_module; qor_host; }
  qor_uicommon      -> { qor_module; qor_host; qor_current; }
  qor_desktopui     -> { qor_module; qor_host; qor_sync; qor_thread; }
  qor_gl            -> { qor_module; qor_host; qor_thread; qor_error; }
  qor_uilayout      -> { qor_module; qor_host; qor_current; qor_uicommon; }
  qor_uiselector    -> { qor_module; qor_host; qor_current; }
  qor_sercon        -> { qor_module; qor_host; qor_current; qor_sync; qor_injection; }
  qor_terminal      -> { qor_module; qor_host; qor_current; qor_uilayout; qor_uicommon; qor_uiwidgets; }
  qor_uiwidgets     -> { qor_module; qor_host; qor_current; qor_uicommon; qor_uilayout; }

  qor_platform -> { qor_module; qor_host; qor_sync; qor_thread; }
  qor_arch     -> { qor_module; qor_host; qor_thread; qor_sharedbootstrap; }
  // qor_compiler: no deps

  // ===== Component edges =====
  qor_jsondata        -> { qor_module; qor_host; qor_current; qor_sync; qor_injection; }
  qor_ttf             -> { qor_module; qor_host; qor_current; qor_reporting; qor_text; }
  qor_parser          -> { qor_module; qor_host; qor_thread; qor_sync; qor_injection; qor_workflow; qor_pipeline; }
  qor_base64decodefilter -> { qor_module; qor_signals; qor_pipeline; }
  qor_base64encodefilter -> { qor_module; qor_signals; qor_pipeline; }
  qor_jpegdecodefilter   -> { qor_module; qor_signals; qor_pipeline; }
  qor_linereader         -> { qor_module; qor_signals; qor_pipeline; }
  qor_unicodetextfilter  -> { qor_module; qor_host; qor_text; qor_signals; qor_pipeline; }
  qor_datasink           -> { qor_module; qor_signals; qor_pipeline; qor_error; }
  qor_deserializersink   -> { qor_module; qor_signals; qor_pipeline; qor_error; qor_log; qor_workflow; qor_parser; }
  qor_parsersink         -> { qor_module; qor_signals; qor_pipeline; qor_error; qor_log; qor_workflow; qor_parser; }
  qor_stringsink         -> { qor_module; qor_signals; qor_pipeline; }
  qor_aggregatesource    -> { qor_module; qor_signals; qor_pipeline; }
  qor_datasource         -> { qor_module; qor_signals; qor_pipeline; qor_error; }
  qor_generatorsource    -> { qor_module; qor_signals; qor_pipeline; qor_generator; }
  qor_randomsource       -> { qor_module; qor_signals; qor_pipeline; qor_error; }
  qor_stringsource       -> { qor_module; qor_signals; qor_pipeline; }
  qor_serialize          -> { qor_module; qor_thread; qor_sync; qor_injection; }
  qor_generator          -> { qor_module; qor_host; qor_thread; qor_sync; qor_injection; }
  qor_netclient          -> { qor_module; qor_host; qor_current; qor_sync; qor_injection; }
  qor_httpclient         -> { qor_http; qor_module; qor_host; qor_thread; qor_sync; qor_injection; }
  qor_socketclient       -> { qor_module; qor_host; qor_thread; qor_sync; qor_injection; }
  qor_netserver          -> { qor_module; qor_host; }
  qor_fileconnector      -> { qor_module; qor_signals; qor_pipeline; }
  qor_pipeconnector      -> { qor_module; qor_signals; qor_pipeline; }
  qor_socketconnector    -> { qor_module; qor_thread; }
  qor_stdfstreamconnector -> { qor_module; qor_signals; qor_pipeline; qor_filesystem; }
  qor_stdofstreamsink    -> { qor_module; qor_signals; qor_pipeline; }
  qor_stdoutsink         -> { qor_module; qor_signals; qor_pipeline; }
  qor_stdifstreamsource  -> { qor_module; qor_signals; qor_pipeline; }
  qor_stdinsource        -> { qor_module; qor_signals; qor_pipeline; qor_error; }
  qor_echo               -> { qor_module; qor_host; qor_current; qor_sync; qor_injection; }
  qor_http               -> { qor_module; qor_host; qor_current; qor_sync; qor_injection; }
  qor_jip                -> { qor_module; qor_host; qor_current; qor_sync; qor_injection; }
  qor_uri                -> { qor_module; qor_host; qor_current; qor_sync; qor_injection; }
  qor_logaggregator      -> { qor_module; qor_thread; qor_sync; qor_signals; qor_error; qor_log; qor_interception; qor_loghandler; qor_filesystem; qor_role; }
  qor_loghandler         -> { qor_module; qor_host; qor_current; qor_issue; qor_signals; qor_log; }
  qor_canvas             -> { qor_module; qor_role; qor_application; qor_error; }
  qor_console            -> { qor_module; qor_thread; qor_sync; qor_injection; qor_role; }
  qor_egl                -> { qor_module; qor_role; qor_application; qor_error; }
  qor_layout             -> { qor_module; qor_role; qor_application; qor_error; }
  qor_opengles           -> { qor_module; qor_role; qor_application; qor_error; qor_egl; }
  qor_renderer           -> { qor_module; qor_role; qor_application; qor_workflow; qor_signals; qor_error; }
  qor_tui                -> { qor_module; qor_role; qor_application; qor_workflow; qor_signals; qor_error; }
  qor_widgets            -> { qor_module; qor_role; qor_application; qor_error; qor_layout; }

  // ===== Platform adapters (non-QOR; referenced but not in QOR graph) =====
  // qor_sharedbootstrap, qor_exebootstrap (win static); winqor_*, linqor_* (external adapters)
  // Per repo_map: not treated as QOR libs. Edges above include qor_sharedbootstrap as a leaf.
}